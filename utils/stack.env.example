TIMEZONE=Europe/Rome
PUID=1000
PGID=1000
UMASK=002

# Subnet diversa da media (172.28.10.0/24). Non riusare la stessa.
DOCKER_SUBNET=172.20.0.0/16
DOCKER_GATEWAY=172.20.0.1

DNS_PRIMARY=8.8.8.8
DNS_SECONDARY=1.1.1.1

FOLDER_FOR_CONFIGS=/DATA/AppData/media-stack
FOLDER_FOR_MEDIA=/hdd

WEBUI_PORT_NEXTCLOUD=8181
NEXTCLOUD_DB_USER=nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=change-me
NEXTCLOUD_DB_PASSWORD=change-me

# Token del tunnel Cloudflare (Zero Trust → Networks → Tunnels).
# Quello vecchio era scritto nel compose: ruotalo e incolla qui il nuovo.
CLOUDFLARED_TUNNEL_TOKEN=change-me

WEBUI_PORT_SYNCTHING=8384
SYNCTHING_SYNC_PORT_TCP=22000
SYNCTHING_SYNC_PORT_UDP=22000
SYNCTHING_DISCOVERY_PORT=21027

# Cartella visibile in File Browser. Prima era /, cioè tutto l'host.
# Rimetti / solo se ti serve davvero l'intero filesystem.
FILEBROWSER_ROOT=/hdd
WEBUI_PORT_FILEBROWSER=8080

GITEA_DOMAIN=git.example.com
GITEA_ROOT_URL=http://git.example.com
GITEA_SSH_PORT=222
WEBUI_PORT_GITEA=1111

WEBUI_PORT_CRAFTY=8443
MINECRAFT_JAVA_PORT=25565
MINECRAFT_BEDROCK_PORT=19132
